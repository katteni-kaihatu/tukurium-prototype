# `pnpm dev` 用。docker-compose.dev.yml で起動した周辺サービスにつなぐ。
# 使うときは apps/server/.env にコピーする（M2 以降でサーバーが読み込む）。
DATABASE_URL=postgres://tukurium:tukurium@localhost:5432/tukurium
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=tukurium
S3_ACCESS_KEY_ID=tukurium
S3_SECRET_ACCESS_KEY=tukurium-dev-secret
