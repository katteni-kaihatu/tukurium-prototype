# docker compose 用。Coolify では環境変数として設定する。
APP_PORT=8787
# ログインに使う Misskey（既定 https://misskey.resonite.love）
MISSKEY_URL=https://misskey.resonite.love
POSTGRES_PASSWORD=change-me
# S3 互換ストレージ（Coolify 側で用意したものを指定）
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=tukurium
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
